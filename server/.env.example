# Copy this file to .env and fill in real values before running the server

# Server port
PORT=3001

# JWT secret — use a long, random string in production (never commit the real value)
JWT_SECRET=replace_with_a_long_random_secret

# Comma-separated list of allowed CORS origins
# In production, set this to your frontend domain e.g. https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173

# Seed admin credentials — only used when the DB is empty for the first time
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=change_this_before_first_run

# PostgreSQL connection string (required)
# Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Render:   postgresql://user:password@hostname:5432/dbname (from Render dashboard)
# Railway:  postgresql://user:password@hostname:5432/dbname (from Railway dashboard)
# Local:    postgresql://user:password@localhost:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/your_database
